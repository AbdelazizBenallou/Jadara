@startuml
' JADARA - Full Class Diagram (all entities)
title JADARA - Full Class Diagram

skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #333333
    FontName Helvetica
}
skinparam nodeFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 0
hide empty members

' =========================================================
' ENUMS
' =========================================================

enum UserStatus {
    active
    inactive
    locked
    pending
}

enum DemandStatus {
    pending
    approved
    rejected
}

enum ProjectStatus {
    draft
    submitted
    under_review
    verified
}

enum SkillLevel {
    beginner
    intermediate
    advanced
    expert
}

enum LanguageProficiency {
    native
    fluent
    advanced
    intermediate
    beginner
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
}

enum CVLanguage {
    AR
    EN
    FR
}

' =========================================================
' CLASSES
' =========================================================

