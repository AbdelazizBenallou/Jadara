@startuml
' JADARA - Full Class Diagram (all entities)
title JADARA - Full Class Diagram

skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #333333
    FontName Helvetica
}
skinparam nodeFontSize 11
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 0
hide empty members

' =========================================================
' ENUMS
' =========================================================

enum UserStatus {
    active
    inactive
    locked
    pending
}

enum DemandStatus {
    pending
    approved
    rejected
}

enum ProjectStatus {
    draft
    under_review
    verified
    rejected
    archived
}

enum SkillLevel {
    beginner
    intermediate
    advanced
    expert
}

enum LanguageProficiency {
    native
    fluent
    advanced
    intermediate
    beginner
}

' =========================================================
' AUTH & ACCESS
' =========================================================

class users {
    + **id** : Int (PK)
    + **email** : String (UNIQUE)
    + password : String
    + status : UserStatus
    + **role_id** : Int (FK)
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getAll(query: { page?, limit? }) : Object
    + getById(id: number) : Object
    + update(id: number, data, adminUserId: number) : Object
    + remove(id: number, adminUserId: number) : void
    + getPublicProfile(id: number) : Object
    + getMyProfile(userId: number) : Object
    + updateMyProfile(userId: number, data, file?) : Object
    + getActivity(userId: number) : Object
    + addSocial(userId: number, platform: string, url: string) : Object
    + removeSocial(userId: number, socialId: number) : void
}

class profiles {
    + **id** : Int (PK)
    + **user_id** : Int (FK, UNIQUE)
    + first_name : String
    + last_name : String
    + phone : String
    + date_of_birth : DateTime
    + gender : String
    + avatar : String
    + bio : String
    + location : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + update(id: number, data) : Object
    + updateAvatar(userId: number, avatarUrl: string) : Object
    + findProfileById(id: number) : Object
    + findPublicProfileById(id: number) : Object
}

class roles {
    + **id** : Int (PK)
    + **name** : String (UNIQUE)
    + is_selectable : Boolean
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll() : Role[]
    + findById(id: number) : Role
    + create(name: string) : Role
    + update(id: number, name: string) : Role
    + delete(id: number) : void
    + countUsersByRoleId(id: number) : number
    + getUsersByRoleId(roleId: number) : Object[]
    + getPermissionsByRoleId(roleId: number) : Permission[]
}

class permissions {
    + **id** : Int (PK)
    + **name** : String (UNIQUE)
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAllPermissions() : Permission[]
    + findPermissionById(id: number) : Permission
    + createPermission(name: string) : Permission
    + updatePermission(id: number, name: string) : Permission
    + deletePermission(id: number) : void
    + countRolesByPermissionId(id: number) : number
    + getRolesByPermissionId(permissionId: number) : Role[]
}

class role_permissions {
    + **id** : Int (PK)
    + **role_id** : Int (FK)
    + **permission_id** : Int (FK)
    + created_at : DateTime
    ..
    + getPermissionsByRoleId(roleId: number) : Permission[]
    + addPermissionToRole(roleId: number, permissionId: number) : void
    + removePermissionFromRole(roleId: number, permissionId: number) : void
    + isPermissionAssignedToRole(roleId: number, permissionId: number) : boolean
    + findRolesByPermissionId(permissionId: number) : Role[]
}

class refresh_tokens {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **token** : String (UNIQUE)
    + expires_at : DateTime
    + created_at : DateTime
    ..
    + create(userId: number, rawToken: string, tx?) : RefreshToken
    + revokeAllByUserId(userId: number) : void
    + deleteExpired() : void
}

class login_history {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + ip_address : String
    + user_agent : String
    + login_at : DateTime
    + success : Boolean
    ..
    + create(userId: number, ipAddress: string, userAgent: string, success: boolean, tx?) : LoginHistory
    + findByUserId(userId: number, limit: number) : LoginHistory[]
}

class devices {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **device_fingerprint** : String (UNIQUE)
    + device_name : String
    + last_active : DateTime
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + upsert(userId: number, ip: string, userAgent: string, tx?) : Device
}

' =========================================================
' CV & PROFILE DATA
' =========================================================

class work_experience {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + company : String
    + job_title : String
    + description : String
    + start_date : DateTime
    + end_date : DateTime
    + is_current : Boolean
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getWorkExperience(userId) : Object[]
    + createWorkExperience(userId, data) : Object
    + updateWorkExperience(userId, id, data) : Object
    + deleteWorkExperience(userId, id) : void
}

class education {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + school : String
    + degree : String
    + field_of_study : String
    + description : String
    + start_date : DateTime
    + end_date : DateTime
    + is_current : Boolean
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getEducation(userId) : Object[]
    + createEducation(userId, data) : Object
    + updateEducation(userId, id, data) : Object
    + deleteEducation(userId, id) : void
}

class certifications {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + name : String
    + issuer : String
    + issue_date : DateTime
    + expiry_date : DateTime
    + credential_url : String
    + file_url : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getCertifications(userId) : Object[]
    + createCertification(userId, data) : Object
    + updateCertification(userId, id, data) : Object
    + deleteCertification(userId, id) : void
}

class user_languages {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **language_id** : Int (FK)
    + proficiency : LanguageProficiency
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getLanguages(userId) : Object[]
    + createLanguage(userId, data) : Object
    + updateLanguage(userId, id, data) : Object
    + deleteLanguage(userId, id) : void
}

class languages {
    + **id** : Int (PK)
    + **name** : String (UNIQUE)
    + code : String (UNIQUE)
    + status : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll() : Language[]
    + findById(id) : Language
    + findByName(name) : Language
    + create(name) : Language
    + update(id, name) : Language
    + countUserLanguages(id) : number
    + remove(id) : void
}

class user_skills {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **skill_id** : Int (FK)
    + level : SkillLevel
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getSkills(userId) : Object[]
    + findUserById(id) : User
    + findExistingSkillIds(ids) : number[]
    + findLinkedSkillIds(userId) : number[]
    + addSkills(userId, skillIds) : void
    + findLink(userId, skillId) : Object
    + updateLevel(userId, skillId, level) : void
    + removeLink(userId, skillId) : void
}

class skills {
    + **id** : Int (PK)
    + **name** : String (UNIQUE)
    + description : String
    + status : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll() : Skill[]
    + findById(id) : Skill
    + findByName(name) : Skill
    + create(name) : Skill
    + update(id, name) : Skill
    + countUserSkills(id) : number
    + countDomainLinks(id) : number
    + remove(id) : void
}

class user_socials {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + platform : String
    + url : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + addSocial(userId, platform, url) : Object
    + removeSocial(userId, socialId) : void
}

' =========================================================
' SKILLS / DOMAINS + PROJECTS & REVIEWS
' =========================================================

class domains {
    + **id** : Int (PK)
    + **name** : String (UNIQUE)
    + **created_by** : Int (FK)
    + status : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll() : Domain[]
    + findById(id) : Domain
    + findByName(name) : Domain
    + create(name, adminUserId) : Domain
    + update(id, name) : Domain
    + countSkillsByDomainId(id) : number
    + countProjectsByDomainId(id) : number
    + getSkillsByDomainId(domainId) : Skill[]
    + findReviewersByDomainId(domainId) : Object[]
    + findAllReviewers() : Object[]
    + findExistingSkillIds(ids) : number[]
    + findLinkedSkillIds(domainId) : number[]
    + addSkillsToDomain(domainId, skillIds) : void
    + remove(id) : void
}

class skill_domains {
    + **id** : Int (PK)
    + **skill_id** : Int (FK)
    + **domain_id** : Int (FK)
    + created_at : DateTime
    ..
    + getSkillsByDomainId(domainId) : Skill[]
    + findExistingSkillIds(ids) : number[]
    + findLinkedSkillIds(domainId) : number[]
    + addSkillsToDomain(domainId, skillIds) : void
    + remove(domainId) : void
}

class reviewer_domains {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **domain_id** : Int (FK)
    + created_at : DateTime
    ..
    + findReviewersByDomainId(domainId) : Object[]
    + findAllReviewers() : Object[]
    + findReviewerDomainIds(reviewerId) : number[]
    + findReviewerDomains(reviewerId) : Object[]
    + setReviewerDomains(reviewerId, domainIds) : void
    + removeReviewerDomain(reviewerId, domainId) : number
}

class projects {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + title : String
    + description : String
    + status : ProjectStatus
    + **domain_id** : Int (FK)
    + github_url : String
    + live_url : String
    + figma_url : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAllByUserId(userId) : Project[]
    + findAll(query) : Object
    + findById(id) : Project
    + findByIdWithUser(id) : Object
    + create(userId, data) : Project
    + update(id, data) : Project
    + updateStatus(id, status) : Project
    + delete(id) : void
    + findExistingDomain(id) : Domain
    + addEvidence(projectId, data) : void
    + removeEvidence(evidenceId) : void
    + findEvidenceById(id) : Evidence
    + ratingsSummary(projectIds) : Map
}

class evidence {
    + **id** : Int (PK)
    + **project_id** : Int (FK)
    + file_url : String
    + file_type : String
    + file_name : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + addEvidence(projectId, data) : void
    + removeEvidence(evidenceId) : void
    + findEvidenceById(id) : Evidence
}

class project_reviews {
    + **id** : Int (PK)
    + **project_id** : Int (FK)
    + **reviewer_id** : Int (FK)
    + rating : Int
    + feedback : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAvailable(reviewerId, domainIds, page, limit) : Object
    + findMine(reviewerId, page, limit) : Object
    + findProjectDetail(projectId) : Project
    + findReviewsByProject(projectId) : Review[]
    + findReview(projectId, reviewerId) : Review
    + createReview(projectId, reviewerId, rating, feedback) : void
    + updateReview(projectId, reviewerId, rating, feedback) : void
    + ratingsSummary(projectIds) : Map
}

class documents {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + name : String
    + type : String
    + file_url : String
    + file_size : Int
    + mime_type : String
    + status : String
    + **demand_id** : Int (FK)
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll(userId) : Document[]
    + findById(id) : Document
    + create(data) : Document
    + delete(id) : void
    + countByUserId(userId) : number
}

' =========================================================
' REGISTRATION DEMANDS
' =========================================================

class demands {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + **role_id** : Int (FK)
    + status : DemandStatus
    + **reviewed_by** : Int (FK)
    + review_note : String
    + reviewed_at : DateTime
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + findAll(page, limit, status?) : { demands, total }
    + findById(id) : Demand
    + findByUserId(userId) : Demand
    + approve(id, adminId, note?) : void
    + reject(id, adminId, note?) : void
}

class demand_domains {
    + **id** : Int (PK)
    + **demand_id** : Int (FK)
    + **domain_id** : Int (FK)
    + created_at : DateTime
    ..
    + createMany(demandId, domainIds) : void
}

class cv_generation_requests {
    + **id** : Int (PK)
    + **user_id** : Int (FK)
    + status : String
    + missing_fields : Json
    + data_hash : String
    + file_url : String
    + file_size : Int
    + error_message : String
    + created_at : DateTime
    + updated_at : DateTime
    ..
    + getLatestRequest(userId) : Request
    + getLatestCompleted(userId) : Request
    + createRequest(userId, status, missingFields?, dataHash?) : Request
    + updateRequest(id, { status?, file_url?, file_size?, error_message?, data_hash? }) : Request
    + getRequests(userId, page, limit) : { requests, total }
    + getAllCvData(userId) : Object
}

' =========================================================
' RELATIONSHIPS
' =========================================================

roles "1" -- "0..*" users
users "1" -- "1" profiles
users "1" -- "0..*" refresh_tokens
users "1" -- "0..*" login_history
users "1" -- "0..*" devices
roles "1" -- "0..*" role_permissions
permissions "1" -- "0..*" role_permissions
users "1" -- "0..*" work_experience
users "1" -- "0..*" education
users "1" -- "0..*" certifications
users "1" -- "0..*" user_socials
users "1" -- "0..*" user_languages
users "1" -- "0..*" user_skills
languages "1" -- "0..*" user_languages
skills "1" -- "0..*" user_skills
users "1" -- "0..*" domains : created_by
users "1" -- "0..*" reviewer_domains
users "1" -- "0..*" projects
users "1" -- "0..*" documents
users "1" -- "0..*" project_reviews : reviewer
skills "1" -- "0..*" skill_domains
domains "1" -- "0..*" skill_domains
domains "1" -- "0..*" reviewer_domains
domains "0..1" -- "0..*" projects
projects "1" -- "0..*" evidence
projects "1" -- "0..*" project_reviews
users "1" -- "0..*" demands : applicant
users "1" -- "0..*" demands : reviewed_by
roles "1" -- "0..*" demands
demands "1" -- "0..*" demand_domains
domains "1" -- "0..*" demand_domains
demands "1" -- "0..*" documents
users "1" -- "0..*" cv_generation_requests

users ..> UserStatus : uses
demands ..> DemandStatus : uses
projects ..> ProjectStatus : uses
user_skills ..> SkillLevel : uses
user_languages ..> LanguageProficiency : uses

@enduml