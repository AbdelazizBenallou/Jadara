NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# SWAGGER_ENABLED defaults to true in development, false in production
# SWAGGER_ENABLED=true

DATABASE_URL=postgresql://jadara_user:<YOUR_PASSWORD>@localhost:5432/jadara

ACCESS_SECRET=your-access-secret-key-change-this
REFRESH_SECRET=your-refresh-secret-key-change-this
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_AVATAR_SIZE=2097152

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jadara
MINIO_USE_SSL=false

# Optional: absolute URL of the web app, used for the "Sign in" link in emails
# FRONTEND_URL=https://jadara.example.com

# Local Postfix relay (Postfix authenticates to Gmail itself)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=Jadara <benallouaziz1414@gmail.com>
# Only needed when bypassing Postfix and talking to a relay directly
# SMTP_USER=
# SMTP_PASS=

